{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Burn Backend FastAPI",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "src.burn_backend.app:app",
        "--host=0.0.0.0",
        "--port=5051",
        "--reload"
      ],
      "justMyCode": true,
      "envFile": "/workspace/.devcontainer/burn_backend/.env",
      "python": "/opt/conda/envs/burn-severity-prod/bin/python",
      "console": "integratedTerminal"
    },
    {
      "name": "Python: TiTiler FastAPI",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "src.titiler.app:app",
        "--host=0.0.0.0",
        "--port=8081",
        "--reload"
      ],
      "justMyCode": true,
      "envFile": "/workspace/.devcontainer/titiler/.env",
      "python": "/opt/conda/envs/titiler-prod/bin/python",
      "console": "integratedTerminal"
    }
  ]
}
